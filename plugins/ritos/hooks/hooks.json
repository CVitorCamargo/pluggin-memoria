{
  "description": "Travas dos ritos: no início da sessão entrega o HANDOFF (com teto de linhas), o git status e os últimos commits; antes de resumir a conversa pede que o resumo guarde o que só está no chat; no fim do turno avisa arquivos sem commit e cobra a documentação de código mudado e de decisão tomada na conversa. Só age em projeto com .claude/ritos.json.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/rodar.sh\" sessao",
            "shell": "bash",
            "timeout": 20,
            "statusMessage": "Lendo HANDOFF e git status"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/rodar.sh\" resumo",
            "shell": "bash",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/rodar.sh\" fim",
            "shell": "bash",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
